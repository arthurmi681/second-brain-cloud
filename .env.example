# =============================================================================
# Second Brain Cloud - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com seus valores
# =============================================================================

# =====================================================
# SUPABASE ( obrigatório )
# =====================================================

# URL do projeto (encontre em Settings → API → Project URL)
SUPABASE_URL=https://xxxxx.supabase.co

# Chave anônima (encontre em Settings → API → anon key)
SUPABASE_ANON_KEY=eyJxxxxx...

# Chave de serviço (Service Role Key) - APENAS para admin, não use no frontend!
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...


# =====================================================
# OPENAI ( obrigatório )
# =====================================================

# API Key (gere em https://platform.openai.com/settings)
OPENAI_API_KEY=sk-xxxxx...


# (Opcional) Anthropic Claude - se preferir usar Claude
# ANTHROPIC_API_KEY=sk-ant-xxxxx...


# =====================================================
# CONFIGURAÇÕES OPCIONAIS
# =====================================================

# Modelo deEmbeddings (padrão: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# Modelo de chat (padrão: gpt-4o-mini)
CHAT_MODEL=gpt-4o-mini

# Número de memórias a buscar (padrão: 5)
TOP_K=5

# Temperatura do modelo (padrão: 0.7)
TEMPERATURE=0.7